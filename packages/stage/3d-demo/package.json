{
  "name": "@polywar/3d-demo",
  "description": "Demo stage for 3D package views: engine canvas, fly + pan-zoom camera (switchable, keeps the pose), theme background, overlay panel that never drives the camera.",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "3d-demo"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build --error",
    "analyse": "npx @papit/analyse",
    "generate:react": "npx @papit/react",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/stage/3d-demo",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/stage/3d-demo"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/web-component": "*",
    "@papit/game-engine": "*",
    "@papit/vector": "*"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@polywar/3d-asset-preview": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "web-component",
    "main": "3d-demo",
    "htmlprefix": "pw",
    "components": {
      "3d-demo": {
        "className": "Demo3D",
        "htmlprefix": "pw"
      }
    }
  }
}

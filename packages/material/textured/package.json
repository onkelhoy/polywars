{
  "name": "@polywar/textured",
  "description": "Textured material for WebGL2: albedo, normal and spec maps (all optional) as GLSL chunks, texture loading and glTF material reading.",
  "keywords": [
    "papit",
    "webgl",
    "material",
    "texture",
    "normal-map"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/material/textured",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/material/textured"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/codeblock": "*",
    "@papit/game-mesh": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "textured",
    "htmlprefix": "",
    "components": {
      "textured": {
        "className": "Textured"
      }
    }
  }
}

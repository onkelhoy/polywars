{
  "name": "@polywar/shooting-range",
  "description": "Shooting range: the model (glb + range.json points), ground, colliders, bullet hits and gun stands.",
  "keywords": [
    "papit",
    "typescript",
    "shooting-range"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/play/shooting-range",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/play/shooting-range"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@polywar/ballistics": "*",
    "@polywar/gun-menu": "*",
    "@papit/vector": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@polywar/viewport": "*",
    "@polywar/renderer": "*",
    "@papit/game-mesh": "*",
    "@papit/matrix": "*",
    "@polywar/weapons": "*",
    "@polywar/characters": "*",
    "@polywar/player": "*",
    "@polywar/viewmodel": "*",
    "@polywar/vehicle": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "shooting-range",
    "htmlprefix": "pw",
    "components": {
      "shooting-range": {
        "className": "ShootingRange"
      }
    }
  }
}

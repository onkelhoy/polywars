{
  "name": "@polywar/player",
  "description": "Playable character: mover + viewmodel + weapons tied together, first person, and the range view.",
  "keywords": [
    "papit",
    "typescript",
    "player"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/play/player",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/play/player"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/game-engine": "*",
    "@papit/game-mesh": "*",
    "@papit/matrix": "*",
    "@polywar/mover": "*",
    "@polywar/weapons": "*",
    "@polywar/ballistics": "*",
    "@polywar/impacts": "*",
    "@polywar/viewmodel": "*",
    "@polywar/renderer": "*",
    "@polywar/characters": "*",
    "@polywar/armory": "*",
    "@papit/audio": "*",
    "@papit/rigidbody": "*",
    "@polywar/weapon-audio": "*",
    "@polywar/debris": "*",
    "@papit/quaternion": "*",
    "@papit/vector": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@polywar/viewport": "*",
    "@papit/game-engine": "*",
    "@papit/rigidbody": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "player",
    "htmlprefix": ""
  }
}

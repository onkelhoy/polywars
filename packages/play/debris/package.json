{
  "name": "@polywar/debris",
  "description": "Spent shells and other small bits as @papit/rigidbody bodies: settle to static, capped, fade out.",
  "keywords": [
    "papit",
    "typescript",
    "physics",
    "shells"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/play/debris",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/play/debris"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/rigidbody": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@polywar/viewport": "*",
    "@polywar/renderer": "*",
    "@papit/game-mesh": "*",
    "@papit/matrix": "*",
    "@polywar/weapons": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "debris",
    "htmlprefix": "pw",
    "components": {
      "debris": {
        "className": "Debris",
        "htmlprefix": "pw"
      }
    }
  }
}

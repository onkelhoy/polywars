{
  "name": "@polywar/renderer",
  "description": "WebGL2 renderer for game-mesh meshes and glTF: one light (sun, hemisphere, lamp, fog, toon), skins, maps, line grid.",
  "keywords": [
    "papit",
    "webgl",
    "renderer",
    "gltf"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/henry/polywar/tree/main/packages/ui/viewport/renderer",
  "bugs": {
    "url": "https://github.com/henry/polywar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry/polywar.git",
    "directory": "packages/ui/viewport/renderer"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/game-engine": "*",
    "@papit/game-mesh": "*",
    "@papit/matrix": "*",
    "@papit/quaternion": "*",
    "@polywar/textured": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/codeblock": "*",
    "@polywar/3d-demo": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "renderer",
    "htmlprefix": "",
    "components": {
      "renderer": {
        "className": "Renderer"
      }
    }
  }
}
